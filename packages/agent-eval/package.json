{
  "name": "@agent/agent-eval",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": ["scope:agent", "type:logic"],
    "targets": {
      "test": {
        "options": {
          "command": "node scripts/run-vitest.mjs run"
        }
      },
      "runs": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs runs", "cwd": "{workspaceRoot}" }
      },
      "metrics": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs metrics", "cwd": "{workspaceRoot}" }
      },
      "analyze": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs analyze", "cwd": "{workspaceRoot}" }
      },
      "seed": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs seed", "cwd": "{workspaceRoot}" }
      },
      "run": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs run", "cwd": "{workspaceRoot}" }
      },
      "baseline": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs baseline", "cwd": "{workspaceRoot}" }
      },
      "gate": {
        "executor": "nx:run-commands",
        "options": { "command": "node packages/agent-eval/scripts/cli.mjs gate", "cwd": "{workspaceRoot}" }
      }
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@agent/agent-models": "*"
  }
}
