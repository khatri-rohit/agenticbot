# Host-run apps/api (copy to .env — gitignored)

# Cloud Ollama (chat / agent). Do not point at Compose for default workflow.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# Local Ollama daemon (UI "Local" mode: /api/tags discovery + chat).
# Default is fine when `ollama serve` is running on this machine.
# OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# System 1: fast local scorer for harness decisions (per-step thinking level).
# Unset URL = disabled; runs behave exactly as without it. Run state (task
# text, tool names) is sent to this URL, so keep it on this machine.
# OLLAMA_SYSTEMONE_URL=http://localhost:11434/v1/systemone
# SYSTEMONE_MODEL=nimble-v3:9b
# enforce (default): the thinking picker offers Auto; only Auto runs change.
# shadow: every run is scored and traced, nothing is applied, Auto is hidden.
# off: never called.
# SYSTEMONE_MODE=enforce
# SYSTEMONE_TIMEOUT_MS=5000
# 1 = also on Local-mode runs (shares the daemon's VRAM with the chat model)
# SYSTEMONE_WITH_LOCAL=0

# Title model for cloud runs (thinking is turned off when the model allows it).
# TITLE_MODEL=gemma4:cloud

# Sub-agent model roles (default: the parent's model). Pick models whose
# /api/show capabilities include "tools".
# AGENT_MODEL_FAST=
# AGENT_MODEL_STRONG=

# Every model call's exact input and output is recorded for the eval viewer (thread blobs/). 0 turns it off.
# AGENT_RECORD_MODEL_CALLS=0

# Web search / fetch (optional). With no keys, clone uses Firecrawl keyless
# then Tavily keyless (shared rate limits). If OLLAMA_API_KEY is set, search
# uses Ollama cloud only. Optional keys raise limits for a single vendor:
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=

# Dev: pin the session catalog/ledger to this clone (gitignored).
# Unset → ~/.local/desk
DESK_HOME=.local/desk

# Voice STT provider (keep web + api in sync):
#   browser  — Web Speech API (default; no Docker / Speaches)
#   speaches — local Speaches via POST /api/voice/transcribe
#   off      — hide voice UI entirely
VOICE_STT_PROVIDER=browser
NEXT_PUBLIC_VOICE_STT_PROVIDER=browser

# Speaches only (VOICE_STT_PROVIDER=speaches + docker compose speaches)
SPEACHES_BASE_URL=http://127.0.0.1:8000
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-large-v3
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_STT_LANGUAGE=en
VOICE_STT_PROMPT=desk, Speaches, Nx monorepo, Ollama, agent-core, RunManager, ChatInput
