# Optional local overrides. Copy to .env.docker (gitignored).
# Defaults work on macOS / Linux / Windows with named volumes.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
#
# This stack is Speaches (STT) only.
# It never starts Ollama and never mounts Ollama model directories.
# Chat stays on cloud via repo root .env (OLLAMA_BASE_URL=https://ollama.com/v1).

# cpu = Speaches CPU image (default). gpu = Speaches CUDA (needs Docker NVIDIA).
COMPOSE_PROFILES=cpu
# COMPOSE_PROFILES=gpu

# --- Data storage (portable named volumes by default) ---
SPEACHES_HF_CACHE_DIR=speaches-hf-cache

# Optional host binds (machine-specific — .env.docker only).
# Do NOT point these at your Ollama models directory.
# SPEACHES_HF_CACHE_DIR=D:/agenticbot/docker-data/speaches/hf-hub

# --- Host ports ---
SPEACHES_HOST_PORT=127.0.0.1:8000

# --- Speaches / faster-distil-whisper-large-v3 ---
# Leave SPEACHES_TAG / SPEACHES_WHISPER_COMPUTE_TYPE unset to use Compose
# per-profile defaults (cpu → latest-cpu + int8_float32, gpu → latest-cuda + float16).
# SPEACHES_TAG=latest-cuda
# SPEACHES_WHISPER_COMPUTE_TYPE=float16
SPEACHES_PRELOAD_MODELS=["Systran/faster-distil-whisper-large-v3"]
SPEACHES_STT_MODEL_TTL=-1
SPEACHES_ENABLE_UI=false
SPEACHES_LOG_LEVEL=info

# --- Host-run apps/api when using Speaches voice ---
# Set matching VOICE_STT_PROVIDER=speaches in repo root .env
SPEACHES_BASE_URL=http://127.0.0.1:8000
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-large-v3
