{
  "name": "@org/agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "langgraph:dev": "langgraphjs dev --no-browser"
  },
  "nx": {
    "projectType": "application",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/agent/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/agent/src/main.ts",
          "tsConfig": "apps/agent/tsconfig.app.json",
          "assets": [
            "apps/agent/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/agent/dist/package.json",
          "{workspaceRoot}/apps/agent/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/agent/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@org/agent:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/agent:build:development"
          },
          "production": {
            "buildTarget": "@org/agent:build:production"
          }
        }
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@org/agent:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/agent:build:development"
          },
          "production": {
            "buildTarget": "@org/agent:build:production"
          }
        }
      },
      "langgraph:dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run langgraph:dev --workspace=@org/agent",
          "cwd": "{workspaceRoot}"
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "eval": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "node ./node_modules/esbuild/bin/esbuild apps/agent/src/eval/run-eval.ts --bundle --platform=node --format=cjs --outfile=apps/agent/dist/run-eval.cjs --packages=external",
            "node apps/agent/dist/run-eval.cjs"
          ],
          "parallel": false,
          "cwd": "{workspaceRoot}"
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    },
    "tags": [
      "scope:agent"
    ]
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-cli": "^1.5.1",
    "@langchain/ollama": "^1.3.0",
    "@openai/agents": "^0.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firecrawl": "^4.42.1",
    "langchain": "^1.5.15",
    "openai": "^7.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0"
  }
}
